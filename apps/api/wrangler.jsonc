{
  "name": "snap-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    // mock | clef | jev. See decisionProviders in src/providers/index.ts.
    "DECISION_PROVIDER": "mock",
    // mock for now. Claude Haiku joins in milestone 5.
    "TEXT_PROVIDER": "mock"
  },

  // Local development and the default deploy use the mock and need no account.
  // `bun run dev:clef` and `bun run deploy:clef` select this environment, which
  // adds the Workers AI binding. Workers AI always runs remotely, so wrangler
  // asks you to log in the first time.
  "env": {
    "cloudflare": {
      "name": "snap-api",
      "ai": { "binding": "AI" },
      "vars": {
        "DECISION_PROVIDER": "clef",
        "TEXT_PROVIDER": "mock",
        "CLEF_MODEL": "clef-flash"
        // If a call fails and you need to see why, add "DEBUG_PROVIDER_ERRORS": "1" here
        // (logs the underlying error; remove afterwards) and "PROVIDER_TIMEOUT_MS": "30000".
      }
    }
  }

  // Jev (or any gateway) needs no binding. Set DECISION_PROVIDER=jev and add the
  // key with: wrangler secret put JEV_API_KEY
  // Optional: JEV_BASE_URL and JEV_MODEL (see src/providers/jev.ts).
}
